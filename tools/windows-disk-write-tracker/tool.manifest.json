{
  "manifestVersion": "2.1",
  "toolId": "windows-disk-write-tracker",
  "displayName": "Disk Write Tracker",
  "licenseTier": "free",
  "risk": "low",
  "build": {
    "kind": "dotnet-msbuild",
    "project": "src/DiskWriteTracker.Cli/DiskWriteTracker.Cli.csproj",
    "configuration": "Release",
    "args": [
      "-r", "win-x64",
      "--self-contained", "true",
      "-o", "dist"
    ]
  },
  "runtime": {
    "kind": "exe",
    "entry": "dist/DiskWriteTracker.exe"
  },
  "artifacts": [
    {
      "kind": "exe",
      "pattern": "dist/*.exe"
    },
    {
      "kind": "lib",
      "pattern": "dist/*.dll"
    },
    {
      "kind": "runtimeconfig",
      "pattern": "dist/*.json"
    },
    {
      "kind": "doc",
      "pattern": "dist/README.txt"
    },
    {
      "kind": "dir",
      "pattern": "dist/data"
    }
  ]
}
