<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiskWriteTracker.Cli</RootNamespace>
    <AssemblyName>DiskWriteTracker</AssemblyName>
  </PropertyGroup>

  <!--
    分发形态只在 Release 下定义。目标是让裸 `dotnet publish -c Release`
    就能产出 manifest 声明的 src/dist/DiskWriteTracker.exe，
    不需要调用方再传一串 -p: 参数。CI 与本地因此走同一条命令，参数不会漂移。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskWriteTracker.Core\DiskWriteTracker.Core.csproj" />
  </ItemGroup>

  <!--
    把 publish 输出整理成最终分发形态：exe + README.txt + data\。
    data 目录必须存在且可以为空 —— 引擎靠「exe 同级存在 data\」判定便携模式
    （Config/RuntimePaths.cs），打包时漏掉空目录会让分发包静默退回 ProgramData。
    README.txt 来自 assets\，它是给最终用户的说明，不参与编译。
  -->
  <Target Name="StageDist" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_DistDir>$(MSBuildProjectDirectory)\..\dist\</_DistDir>
      <_PublishRoot Condition="'$(PublishDir)' != ''">$(PublishDir)</_PublishRoot>
      <_PublishRoot Condition="'$(PublishDir)' == ''">$(OutputPath)publish\</_PublishRoot>
    </PropertyGroup>

    <MakeDir Directories="$(_DistDir)" />
    <MakeDir Directories="$(_DistDir)data" />

    <Error Condition="!Exists('$(_PublishRoot)$(AssemblyName).exe')"
           Text="publish 未产出 $(_PublishRoot)$(AssemblyName).exe" />

    <Copy SourceFiles="$(_PublishRoot)$(AssemblyName).exe" DestinationFolder="$(_DistDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\assets\README.txt"
          DestinationFiles="$(_DistDir)README.txt"
          Condition="Exists('$(MSBuildProjectDirectory)\..\assets\README.txt')" />
  </Target>

</Project>
