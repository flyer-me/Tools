<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiskWriteTracker.Cli</RootNamespace>
    <AssemblyName>DiskWriteTracker</AssemblyName>
    <!-- 交付形态：自包含多文件（依赖旁置 dll），用户无需安装运行时 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 裁剪未用 BCL。Core 零 NuGet 依赖，仅有 WScript.Shell 运行时 COM 晚绑定
         （不受 IL 裁剪影响）；STJ 载荷已改用源生成上下文静态引用 -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 反射式 STJ 开关。CLI 与报表载荷已改用源生成上下文静态引用 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 只携带英文与简体中文资源 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskWriteTracker.Core\DiskWriteTracker.Core.csproj" />
  </ItemGroup>

</Project>
