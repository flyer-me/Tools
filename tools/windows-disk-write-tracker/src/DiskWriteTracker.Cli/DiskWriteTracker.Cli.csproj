<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiskWriteTracker.Cli</RootNamespace>
    <AssemblyName>DiskWriteTracker</AssemblyName>
    <!-- 发布属性属地划分：RID 与自包含是"怎么构建"，固化在项目文件里，
         裸 dotnet publish 即产出交付物；输出目录 -o dist 是"产物落在哪"，
         属于 manifest 的产物契约（artifacts pattern 引用 dist/）。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 交付形态：自包含多文件（依赖旁置 dll），用户无需安装运行时 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 裁剪未用 BCL。Core 零 NuGet 依赖，仅有 WScript.Shell 运行时 COM 晚绑定
         （不受 IL 裁剪影响）；STJ 载荷已改用源生成上下文静态引用 -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 关闭反射式序列化：全部序列化走源生成上下文，裁剪器可移除反射序列化器。
         此前开启是因为 JSON 输出走运行时类型解析，该路径已删除。 -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 只携带英文与简体中文资源 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskWriteTracker.Core\DiskWriteTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 菜单文案模板：banner + 菜单项，与 InteractiveMenu 的动作字典按 key 对齐 -->
    <EmbeddedResource Include="Interactive\menu-layout.txt" LogicalName="menu-layout.txt" />
  </ItemGroup>

</Project>
