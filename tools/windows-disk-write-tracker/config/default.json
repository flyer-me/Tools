{
  "data": {
    "directory": "%ProgramData%\\DiskWriteTracker",
    "fallbackDirectory": "%LOCALAPPDATA%\\DiskWriteTracker",
    "retentionDays": 3650
  },
  "sampling": {
    "dailyTime": "00:05",
    "timeoutSeconds": 30
  },
  "units": {
    "requireWearGate": true
  },
  "logging": {
    "level": "INFO",
    "retentionDays": 30,
    "maxFileBytes": 1048576
  }
}
