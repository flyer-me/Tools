{
  "manifestVersion": "2.1",
  "toolId": "hs2modpackanalyzer",
  "displayName": "HS2 Modpack Analyzer",
  "licenseTier": "free",
  "build": {
    "kind": "dotnet-msbuild",
    "project": "src/HS2ModpackAnalyzer.csproj",
    "configuration": "Release",
    "args": [
      "-p:NuGetAudit=false"
    ]
  },
  "runtime": {
    "kind": "exe",
    "entry": "src/dist/HS2ModpackAnalyzer.exe"
  },
  "artifacts": [
    {
      "kind": "exe",
      "pattern": "src/dist/*.exe"
    },
    {
      "kind": "config",
      "pattern": "src/dist/*.config"
    }
  ]
}
