root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# 脚本一律 CRLF：cmd.exe 与旧版 PowerShell 对 LF-only 的处理不一致
[*.{bat,cmd,ps1}]
end_of_line = crlf

# 现有脚本都按 4 空格缩进，改规则去迎合现状，而不是制造一次全仓 diff
[*.ps1]
indent_size = 4

[*.{bat,cmd}]
indent_size = 4
